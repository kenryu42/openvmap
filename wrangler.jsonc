{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openvmap",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-09",
  "assets": {
    // The static export of the Next.js site (bun run build).
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  // No request logs: they would hold who checked what (see /about).
  "rules": [{ "type": "Text", "globs": ["**/*.yaml"], "fallthrough": true }],
  "observability": { "enabled": false },
  "ratelimits": [
    // Per client, per Cloudflare location: 10 PHP checks a minute.
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
  ],
}
