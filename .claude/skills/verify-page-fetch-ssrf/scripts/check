#!/usr/bin/env bash
set -euo pipefail

skill="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
tla_version="v1.7.4"
tla_sha256="936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/openvmap-tla/$tla_version"
jar="$cache/tla2tools.jar"

command -v java >/dev/null || { echo "java not found; install a JDK 11 or later" >&2; exit 3; }
if [ ! -f "$jar" ] || [ "$(shasum -a 256 "$jar" | cut -d' ' -f1)" != "$tla_sha256" ]; then
  mkdir -p "$cache"
  curl -fsSL -o "$jar.part" "https://github.com/tlaplus/tlaplus/releases/download/$tla_version/tla2tools.jar"
  [ "$(shasum -a 256 "$jar.part" | cut -d' ' -f1)" = "$tla_sha256" ] || { echo "tla2tools.jar checksum mismatch" >&2; rm -f "$jar.part"; exit 3; }
  mv "$jar.part" "$jar"
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

tlc() {
  local config="$1" out="$2"
  set +e
  (cd "$skill/model" && java -XX:+UseParallelGC -cp "$jar" tlc2.TLC -workers auto -cleanup \
    -metadir "$work/states-$config" -config "$config.cfg" PageFetch.tla) >"$out" 2>&1
  local status=$?
  set -e
  return $status
}

trace() {
  awk '/^State [0-9]+: </ { sub(/ line [0-9].*>/, ">"); print; keep = 0; next }
       /^\/\\ / { keep = ($2 == "url" || $2 == "checked" || $2 == "pageRequestsDelivered") }
       /^[0-9]+ states generated/ { exit }
       keep { print }' "$1"
}

if tlc PageFetch "$work/check.out"; then
  echo "PASS TypeOK, NoPageRequestReachesPrivateAddress, NoCertProbeReachesPrivateAddress, PageRequestsWithinBudget, no deadlock"
  grep -E "^[0-9]+ states generated" "$work/check.out"
else
  echo "FAIL"
  grep -E '^Error|is violated' "$work/check.out" || tail -20 "$work/check.out"
  trace "$work/check.out"
  exit 1
fi
